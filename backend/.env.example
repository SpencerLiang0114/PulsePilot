MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# off: deterministic only; observe: diagnostics; assist: rules + explanations (default);
# adaptive: consented pre-commit action selection. Passive/rules preferences still apply.
AGENT_MODE=assist
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Defaults to ../.vendor/open-rppg relative to this project.
# FACEPHYS_ROOT=/absolute/path/to/open-rppg

# Optional hackathon credentials; orchestration uses only MODEL_API_KEY.
FIREWORKS_API_KEY=
BASETEN_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROFILE=
